# The plaintext archive is an intermediate: tools/seal_corpus.py turns it
# into the sealed asset that actually ships.
assets/db/qamus.corpus.xz

# The Play upload key. CI writes these from repository secrets; they must
# never be committed — anyone holding them can publish as you.
/android/key.properties
/android/app/upload-keystore.jks
